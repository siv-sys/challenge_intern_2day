                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks - page=0 (fail: 400)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks?page=0",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [{ "key": "page", "value": "0" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
