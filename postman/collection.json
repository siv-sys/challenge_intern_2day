                  "  const body = pm.response.json();",
                  "  pm.expect(body.errors).to.have.property('page');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks - sortBy=DROP (fail: 400)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks?sortBy=DROP",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [{ "key": "sortBy", "value": "DROP" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('sortBy error reported, whitelist enforced', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errors).to.have.property('sortBy');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Ownership (cross-user access)",
      "item": [
        {
          "name": "Register Second User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Robert Jones\",\"email\":\"robert.jones.{{$timestamp}}@example.com\",\"password\":\"Xk9#mQ7vLp2!zR44\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.environment.set('secondaryEmail', body.data.email);",
                  "  pm.environment.set('secondaryPassword', 'Xk9#mQ7vLp2!zR44');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Second User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{secondaryEmail}}\",\"password\":\"{{secondaryPassword}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.success) pm.environment.set('token2', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Another User's Task (fail: 404, not 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token2}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404 (id enumeration is not distinguishable from ownership)', () => pm.response.to.have.status(404));",
                  "pm.test('generic not-found message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.message.toLowerCase()).to.include('not found');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - Tasks (cleanup)",
      "item": [
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
