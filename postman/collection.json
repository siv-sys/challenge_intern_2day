{
  "info": {
    "_postman_id": "b1a7e9d2-4c6f-4a2b-9e3d-challenge-intern",
    "name": "Challenge Intern - Task Management API",
    "description": "Auth + Task management API. Run folders top-to-bottom (or use Collection Runner) — later requests depend on variables saved by earlier ones (token, taskId, primaryEmail, ...).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Jane Doe\",\"email\":\"jane.doe.{{$timestamp}}@example.com\",\"password\":\"S3cur3P@ssphrase!9x\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('success true and no password field', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data).to.not.have.property('password');",
                  "});",
                  "if (body.success) {",
                  "  pm.environment.set('primaryEmail', body.data.email);",
                  "  pm.environment.set('primaryPassword', 'S3cur3P@ssphrase!9x');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Weak Password (fail: 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Weak Pass\",\"email\":\"weakpass.{{$timestamp}}@example.com\",\"password\":\"weak\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('validation error keyed by password', () => {",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.errors).to.have.property('password');",
                  "  pm.expect(body.errors.password.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Duplicate Email (fail: 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Jane Doe\",\"email\":\"{{primaryEmail}}\",\"password\":\"An0ther$ecureP9ss\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('duplicate email message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.message.toLowerCase()).to.include('already registered');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{primaryEmail}}\",\"password\":\"{{primaryPassword}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token and no password field', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data).to.have.property('token');",
                  "  pm.expect(body.data.user).to.not.have.property('password');",
                  "});",
                  "if (body.success) {",
                  "  pm.environment.set('token', body.data.token);",
                  "  pm.environment.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Bad Credentials (fail: 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{primaryEmail}}\",\"password\":\"WrongPassword123!\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('generic invalid credentials message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.message).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('matches logged in user, no password field', () => {",
                  "  pm.expect(body.data.email).to.eql(pm.environment.get('primaryEmail'));",
                  "  pm.expect(body.data).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Tasks (happy path)",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Write report\",\"description\":\"Q3 summary\",\"status\":\"pending\",\"dueDate\":\"2026-08-10\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('task belongs to caller', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data.userId).to.eql(Number(pm.environment.get('userId')));",
                  "});",
                  "if (body.success) pm.environment.set('taskId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks?page=1&limit=10&sortBy=createdAt&sortOrder=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "DESC" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paginated envelope shape', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body).to.have.property('meta');",
                  "  pm.expect(body.meta).to.include.all.keys('page','limit','total','totalPages','hasNextPage','hasPrevPage');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the created task', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.id).to.eql(Number(pm.environment.get('taskId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"in_progress\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status field updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.eql('in_progress');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Tasks (validation failures)",
      "item": [
        {
