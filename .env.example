# Server
PORT=3000
NODE_ENV=development

# Database
# Standalone/local MySQL install typically listens on 3306.
# The bundled docker-compose.yml maps the container to host port 3309
# (chosen to avoid clashing with other local MySQL instances) — set
# DB_PORT=3309 if you run `docker compose up -d` from this repo.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=challenge_intern

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:5173
